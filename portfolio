<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg: #080a09;
  --bg2: #0e100f;
  --bg3: #161918;
  --border: rgba(255,255,255,0.06);
  --border2: rgba(255,255,255,0.11);
  --text: #dde8de;
  --text2: #7a8f7b;
  --text3: #445045;
  --green: #4ade80;
  --green-dim: rgba(74,222,128,0.07);
  --green-border: rgba(74,222,128,0.18);
  --amber: #fbbf24;
  --amber-dim: rgba(251,191,36,0.07);
  --blue: #60a5fa;
  --blue-dim: rgba(96,165,250,0.07);
  --mono: 'DM Mono', monospace;
  --serif: 'Instrument Serif', serif;
  --sans: 'DM Sans', sans-serif;
}

html { scroll-behavior: smooth; }

body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--sans);
  font-weight: 300;
  line-height: 1.7;
  font-size: 15px;
  overflow-x: hidden;
}

/* noise overlay */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.035'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 0;
  opacity: 0.6;
}

a { color: inherit; text-decoration: none; }
a:hover { color: var(--green); }

/* ── NAV ── */
nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 40px;
  height: 56px;
  background: rgba(8,10,9,0.82);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--border);
}

.nav-logo {
  font-family: var(--mono);
  font-size: 13px;
  color: var(--green);
  letter-spacing: 0.02em;
}

.nav-links {
  display: flex; gap: 32px;
  list-style: none;
}

.nav-links a {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text2);
  transition: color 0.2s;
}

.nav-links a:hover { color: var(--green); }

/* ── HERO ── */
#hero {
  min-height: 100vh;
  display: flex; flex-direction: column; justify-content: center;
  padding: 100px 40px 80px;
  max-width: 1100px;
  margin: 0 auto;
  position: relative;
}

.hero-eyebrow {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--green);
  margin-bottom: 24px;
  display: flex; align-items: center; gap: 12px;
}

.hero-eyebrow::after {
  content: '';
  display: block;
  width: 48px; height: 1px;
  background: var(--green);
  opacity: 0.4;
}

h1.hero-name {
  font-family: var(--serif);
  font-size: clamp(52px, 8vw, 96px);
  font-weight: 400;
  line-height: 1.0;
  color: var(--text);
  margin-bottom: 8px;
  letter-spacing: -0.02em;
}

h1.hero-name em {
  font-style: italic;
  color: var(--green);
}

.hero-title {
  font-family: var(--mono);
  font-size: 13px;
  color: var(--text2);
  margin-bottom: 36px;
  letter-spacing: 0.05em;
}

.hero-desc {
  max-width: 560px;
  font-size: 16px;
  color: var(--text2);
  line-height: 1.8;
  margin-bottom: 48px;
}

.hero-desc strong {
  color: var(--text);
  font-weight: 400;
}

.hero-chips {
  display: flex; flex-wrap: wrap; gap: 8px;
  margin-bottom: 48px;
}

.chip {
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 5px 12px;
  border-radius: 2px;
  border: 1px solid var(--border2);
  color: var(--text2);
  background: var(--bg2);
}

.chip.green { border-color: var(--green-border); color: var(--green); background: var(--green-dim); }
.chip.amber { border-color: rgba(251,191,36,0.25); color: var(--amber); background: var(--amber-dim); }
.chip.blue  { border-color: rgba(96,165,250,0.25); color: var(--blue);  background: var(--blue-dim); }

.hero-links {
  display: flex; gap: 16px; flex-wrap: wrap;
}

.btn {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 10px 20px;
  border: 1px solid var(--border2);
  border-radius: 2px;
  color: var(--text2);
  transition: all 0.2s;
}

.btn:hover { border-color: var(--green); color: var(--green); background: var(--green-dim); }
.btn.primary { border-color: var(--green); color: var(--green); background: var(--green-dim); }
.btn.primary:hover { background: rgba(74,222,128,0.14); }

.hero-grid {
  position: absolute; right: 0; top: 50%;
  transform: translateY(-50%);
  width: 280px; height: 280px;
  opacity: 0.04;
  display: grid; grid-template-columns: repeat(8,1fr); gap: 6px;
}

.hero-grid-dot {
  width: 3px; height: 3px;
  background: var(--green);
  border-radius: 50%;
  margin: auto;
}

/* ── SECTIONS ── */
section {
  max-width: 1100px;
  margin: 0 auto;
  padding: 100px 40px;
  border-top: 1px solid var(--border);
}

.section-label {
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--green);
  margin-bottom: 48px;
  display: flex; align-items: center; gap: 12px;
}

.section-label::after {
  content: '';
  flex: 1; max-width: 80px; height: 1px;
  background: var(--green); opacity: 0.3;
}

h2.section-title {
  font-family: var(--serif);
  font-size: clamp(28px, 4vw, 44px);
  font-weight: 400;
  color: var(--text);
  margin-bottom: 48px;
  letter-spacing: -0.01em;
}

/* ── EXPERIENCE ── */
.exp-grid { display: flex; flex-direction: column; gap: 2px; }

.exp-item {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 24px;
  padding: 28px 32px;
  background: var(--bg2);
  border: 1px solid var(--border);
  border-radius: 4px;
  transition: border-color 0.2s, background 0.2s;
}

.exp-item:hover {
  border-color: var(--border2);
  background: var(--bg3);
}

.exp-role {
  font-size: 15px;
  font-weight: 500;
  color: var(--text);
  margin-bottom: 4px;
}

.exp-place {
  font-family: var(--mono);
  font-size: 11px;
  color: var(--green);
  margin-bottom: 12px;
  letter-spacing: 0.05em;
}

.exp-bullets {
  list-style: none;
  display: flex; flex-direction: column; gap: 6px;
}

.exp-bullets li {
  font-size: 13px;
  color: var(--text2);
  padding-left: 16px;
  position: relative;
}

.exp-bullets li::before {
  content: '—';
  position: absolute; left: 0;
  color: var(--text3);
  font-family: var(--mono);
}

.exp-date {
  font-family: var(--mono);
  font-size: 10px;
  color: var(--text3);
  letter-spacing: 0.1em;
  white-space: nowrap;
  padding-top: 4px;
}

/* ── PROJECTS ── */
.projects-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 2px;
}

.project-card {
  padding: 28px 28px 24px;
  background: var(--bg2);
  border: 1px solid var(--border);
  border-radius: 4px;
  display: flex; flex-direction: column;
  transition: border-color 0.2s, background 0.2s;
  position: relative;
  overflow: hidden;
}

.project-card::before {
  content: '';
  position: absolute; top: 0; left: 0; right: 0;
  height: 2px;
  background: transparent;
  transition: background 0.2s;
}

.project-card:hover { border-color: var(--border2); background: var(--bg3); }
.project-card:hover::before { background: var(--green); }
.project-card.amber:hover::before { background: var(--amber); }
.project-card.blue:hover::before { background: var(--blue); }

.project-tag {
  font-family: var(--mono);
  font-size: 9px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--text3);
  margin-bottom: 12px;
}

.project-name {
  font-size: 15px;
  font-weight: 500;
  color: var(--text);
  margin-bottom: 10px;
  line-height: 1.3;
}

.project-desc {
  font-size: 13px;
  color: var(--text2);
  line-height: 1.7;
  flex: 1;
  margin-bottom: 16px;
}

.project-metrics {
  display: flex; flex-wrap: wrap; gap: 6px;
  margin-bottom: 16px;
}

.metric-tag {
  font-family: var(--mono);
  font-size: 9px;
  letter-spacing: 0.05em;
  padding: 3px 8px;
  border-radius: 2px;
  border: 1px solid var(--green-border);
  color: var(--green);
  background: var(--green-dim);
}

.metric-tag.amber {
  border-color: rgba(251,191,36,0.25);
  color: var(--amber);
  background: var(--amber-dim);
}

.metric-tag.blue {
  border-color: rgba(96,165,250,0.25);
  color: var(--blue);
  background: var(--blue-dim);
}

.project-tools {
  font-family: var(--mono);
  font-size: 10px;
  color: var(--text3);
  letter-spacing: 0.05em;
}

.project-link {
  display: inline-flex; align-items: center; gap: 6px;
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text3);
  margin-top: 12px;
  transition: color 0.2s;
}

.project-link:hover { color: var(--green); }

/* ── SKILLS ── */
.skills-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 2px;
}

.skill-group {
  padding: 24px 28px;
  background: var(--bg2);
  border: 1px solid var(--border);
  border-radius: 4px;
}

.skill-group-label {
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--green);
  margin-bottom: 16px;
}

.skill-list {
  list-style: none;
  display: flex; flex-direction: column; gap: 6px;
}

.skill-list li {
  font-size: 12px;
  color: var(--text2);
  font-family: var(--mono);
}

/* ── CONTACT ── */
#contact {
  text-align: center;
  padding-bottom: 120px;
}

#contact .section-label { justify-content: center; }
#contact .section-label::after { display: none; }

.contact-tagline {
  font-family: var(--serif);
  font-size: clamp(24px, 4vw, 40px);
  font-weight: 400;
  font-style: italic;
  color: var(--text2);
  max-width: 540px;
  margin: 0 auto 40px;
  line-height: 1.4;
}

.contact-links {
  display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;
}

/* ── FOOTER ── */
footer {
  border-top: 1px solid var(--border);
  padding: 24px 40px;
  display: flex; justify-content: space-between; align-items: center;
  max-width: 1100px;
  margin: 0 auto;
}

.footer-note {
  font-family: var(--mono);
  font-size: 10px;
  color: var(--text3);
  letter-spacing: 0.08em;
}

/* ── ANIMATIONS ── */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}

.fade-up {
  opacity: 0;
  animation: fadeUp 0.6s ease forwards;
}

.fade-up:nth-child(1) { animation-delay: 0.1s; }
.fade-up:nth-child(2) { animation-delay: 0.2s; }
.fade-up:nth-child(3) { animation-delay: 0.3s; }
.fade-up:nth-child(4) { animation-delay: 0.4s; }
.fade-up:nth-child(5) { animation-delay: 0.5s; }
.fade-up:nth-child(6) { animation-delay: 0.6s; }

@media (max-width: 640px) {
  nav { padding: 0 20px; }
  section, #hero { padding-left: 20px; padding-right: 20px; }
  .nav-links { display: none; }
  .exp-item { grid-template-columns: 1fr; }
  .hero-grid { display: none; }
}
</style>
